{
  "name": "inception-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "npm run build && npm start",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.integration.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
