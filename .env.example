VIEWER_TOKEN=replace-with-another-random-key-at-least-32-characters
HOST=127.0.0.1
PORT=4318
# Explicit local convenience only. Hosted mode must use false + HTTPS PUBLIC_ORIGIN.
LOCAL_DEMO=true
