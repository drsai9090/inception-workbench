{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "skipLibCheck": true
  },
  "include": ["src", "test"]
}
